{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "RTS_OUTPUT_SUFFIX": "" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "RTS_OUTPUT_SUFFIX": "_release" }
    },
    {
      "name": "profile",
      "displayName": "Release + Tracy/PIX",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "RTS_PROFILE": "ON", "RTS_OUTPUT_SUFFIX": "_profile" }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "RTS_ASAN": "ON", "RTS_OUTPUT_SUFFIX": "_asan" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "asan",    "configurePreset": "asan" }
  ]
}
